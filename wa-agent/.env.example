# ==============================
# 1. Konfigurasi Docker OpenWA
# ==============================
# Copy file ini menjadi .env di folder wa-agent/ bila perlu mengubah engine
ENGINE_TYPE=baileys
AUTO_START_SESSIONS=true

# ==============================
# 2. Variabel untuk .env.local Aplikasi CCE (Komputer Kantor)
# ==============================
# Tambahkan baris di bawah ini ke C:\cce_app\.env.local
# (Salin terlebih dahulu .env.local dari laptop Anda untuk FIREBASE_* & GEMINI_API_KEY)
#
# OPENWA_BASE_URL=http://localhost:2785
# OPENWA_API_KEY=tempel_api_key_dari_dashboard_openwa
# OPENWA_SESSION_ID=cce-admin
# OPENWA_WEBHOOK_SECRET=ganti_dengan_kata_rahasia_panjang_anda
#
# Isi NEXT_PUBLIC_APP_URL dengan URL web CCE produksi Anda (mis. Vercel),
# supaya link invoice yang dikirim bot WA bisa langsung dibuka dari HP di mana saja:
# NEXT_PUBLIC_APP_URL=https://domain-cce-anda.vercel.app
#
# Pastikan juga variabel berikut sudah ada di C:\cce_app\.env.local:
# GEMINI_API_KEY=...
# FIREBASE_PROJECT_ID=...
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_PRIVATE_KEY=...
# NEXT_PUBLIC_FIREBASE_...
